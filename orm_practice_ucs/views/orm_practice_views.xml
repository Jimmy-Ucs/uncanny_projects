<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view" model="ir.ui.view">
        <field name="name">orm.practice.form</field>
        <field name="model">orm.practice</field>
        <field name="arch" type="xml">
            <form string="sale order">
                <sheet>
                    <header>
                        <button name="custom_method" type="object" string="custom-method" icon="fa-truck"/>
                        <button name="action_confirm" string="Confirm" type="object"/>
                        <button name="action_cancel" string="Cancel" type="object"/>
                        <field name="state" widget="statusbar" statusbar_visible="confirmed,cancelled"/>
                    </header>
                    <div class="oe_button_box" name="button_box">
                   <button class="oe_stat_button" type="object"
                           string="Appointments" name="show_appointments"
                           icon="fa-pencil-square-o">
                    <field name="appointments" widget="statinfo" string="appointments"/>
                </button>
               </div>
                    <group>
                        <field name="name"/>
                        <field name="surname"/>
                        <field name="age"/>
                        <field name="is_boolean"/>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_order_list_view" model="ir.ui.view">
        <field name="name">orm.practice.list</field>
        <field name="model">orm.practice</field>
        <field name="arch" type="xml">
            <list string="sale order" decoration-bf="name=='jimmy'"  decoration-it="surname=='unknownhdada'">
                <field name="name"/>
                <field name="surname"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="sale_order_action" model="ir.actions.act_window">
        <field name="name">sale order</field>
        <field name="res_model">orm.practice</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sale_order_menu"
              name="sale_order"
              sequence="100"
              action="sale_order_action"/>
</odoo>