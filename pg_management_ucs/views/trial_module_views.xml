<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trial_module_form_view" model="ir.ui.view">
            <field name="name">pg.management.form</field>
            <field name="model">pg.management</field>
            <field name="arch" type="xml">
                <form string="Trial Module">
                    <sheet>
                        <field name="name"/>
                        <field name="surname"/>
                        <field name="address"/>
<!--                        <field name="order_id"/>-->
                    </sheet>
                </form>
            </field>
    </record>


    <record id="trial_module_list_view" model="ir.ui.view">
            <field name="name">pg.management.list</field>
            <field name="model">pg.management</field>
            <field name="arch" type="xml">
                <list string="Trial Module">
                        <field name="name"/>
                        <field name="surname"/>
                        <field name="address"/>
                </list>
            </field>
    </record>

    <record id="trial_module_action" model="ir.actions.act_window">
        <field name="name">My Module</field>
        <field name="res_model">pg.management</field>
        <field name="view_mode">list,form</field>
<!--        <field name="target">inline</field>-->
<!--        <field name="context">{'module' : 'hr', 'bin_size': False}</field>-->
    </record>

    <menuitem id="trial_module_menu"
        name="PG Management"
        sequence="100"
        action="trial_module_action"/>
</odoo>