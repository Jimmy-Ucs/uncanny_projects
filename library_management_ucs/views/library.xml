<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="library_list_view" model="ir.ui.view">
            <field name="name">library.list.view</field>
            <field name="model">library</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>

                    <field name="birthdate"/>
                    <field name="deathdate" />
                    <field name="biography"/>
                </list>
            </field>
        </record>

        <record id="library_form_view" model="ir.ui.view">
            <field name="name">library.form.view</field>
            <field name="model">library</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="birthdate"/>
                        <field name="deathdate" />
                        <field name="biography"/>
                        <field name="note"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="editor"/>

                    </group>
                </form>
            </field>
        </record>

        <record id="library_search_view" model="ir.ui.view">
            <field name="name">library.search.view</field>
            <field name="model">library</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>
        <record id="library_kanban_view" model="ir.ui.view">
            <field name="name">library.kanban.view</field>
            <field name="model">library</field>
            <field name="arch" type="xml">
                <kanban>
                    <template>
                        <!--                        <field name="name"/>-->
                    </template>
                </kanban>
            </field>
        </record>

        <record id="library_management_action" model="ir.actions.act_window">
            <field name="name">Library</field>
            <field name="res_model">library</field>
            <field name="view_mode">list,form,search,kanban</field>
        </record>

        <menuitem id="library_management_menu"
                  action="library_management_action"
                  name="Library" />
    </data>
</odoo>
