<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="library_rack_list_view" model="ir.ui.view">
            <field name="name">library.list.view</field>
            <field name="model">library.rack</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="library_rack_form_view" model="ir.ui.view">
            <field name="name">library.form.view</field>
            <field name="model">library.rack</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="library_rack_search_view" model="ir.ui.view">
            <field name="name">library.search.view</field>
            <field name="model">library.rack</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </search>
            </field>
        </record>
        <record id="library_rack_kanban_view" model="ir.ui.view">
            <field name="name">library.kanban.view</field>
            <field name="model">library.rack</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-12">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>

                                <div>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="library_management_rack" model="ir.actions.act_window">
            <field name="name">Library Rack</field>
            <field name="res_model">library.rack</field>
            <field name="view_mode">list,form,search,kanban</field>
        </record>

        <menuitem id="library_management_rack_menu"
                  action="library_management_rack"
                  name="Library Rack" />
    </data>
</odoo>
