<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_data_import_update_wizard" model="ir.ui.view">
        <field name="name">student.data.wizard</field>
        <field name="model">student.data.wizard</field>
        <field name="arch" type="xml">
            <form string="Import student data Wizard">
                <group string="student data" >
                    <group>
                        <field name="excel_file" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button name="load_student_data" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
