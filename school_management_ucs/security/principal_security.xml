<odoo>


    <record id="group_principal" model="res.groups">
        <field name="name">Principal</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="principal_create_rule" model="ir.rule">
        <field name="name">Principal can only create their own records</field>
        <field name="model_id" ref="school_management_ucs.model_standard"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('school_management_ucs.group_principal'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>


</odoo>