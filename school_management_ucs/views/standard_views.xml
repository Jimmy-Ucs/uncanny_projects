<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="standard_form_view" model="ir.ui.view">
        <field name="name">standard.form</field>
        <field name="model">standard</field>
        <field name="arch" type="xml">
            <form string="standard">
                <header>
                    <button string ="Import student data"
                            name="action_import_student_data"
                            type="object"
                            class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="desc"/>
                    </group><group>
                    <notebook string="Result">

                        <page string="subjects" name="subject_name">
                            <field name="subject" string="name"/>
                        </page>
                        <page string="remarks" name="remarks of subject">
                            <field name="remarks"/>
                        </page>
                    </notebook></group>
                </sheet>
            </form>
        </field>
    </record>

