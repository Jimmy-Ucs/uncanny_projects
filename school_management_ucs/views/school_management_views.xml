    <record id="sale_management_kanban_view" model="ir.ui.view">
        <field name="name">sale.order.kanban.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_kanban_with_onboarding" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="invoice_id"/>
            </xpath>
            </field>
    </record>

           <record id="sale_management_list_view" model="ir.ui.view">
        <field name="name">sale.order.list.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="invoice_id"/>
            </xpath>
            </field>
           </record>

      <record id="sale_management_search_view" model="ir.ui.view">
        <field name="name">sale.order.search.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation" />
        <field name="arch" type="xml">
        <xpath expr="//search/field[@name='campaign_id']" position="after">
                <field name="invoice_id" string="invoice"/>
                <filter string="invoice" name="invoice_id" domain="[('state','in', ('draft', 'sent'))]"/>

        </xpath>
            </field>
           </record>




<record id="school_management_action" model="ir.actions.act_window">
        <field name="name">school management</field>
        <field name="res_model">school.management</field>
        <field name="view_mode">search,kanban,form,list</field>
    </record>

    <menuitem id="school_management_menu_root"
              name="school management"
              sequence="100"
              action="school_management_action"/>

    <menuitem id="academic_month_menu"
              name="academic month"
              sequence="101"
              parent="school_management_menu_root"
              action="school_management_action"/>

    <menuitem id="academic_month_menu1"
              name="academic year"
              sequence="102"
              parent="academic_month_menu"
              action="school_management_action"/>

</odoo>
