<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="school_management_form_view" model="ir.ui.view">
        <field name="name">school.management.form</field>
        <field name="model">school.management</field>
        <field name="arch" type="xml">
            <form string="school Management">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="l_date"/>
                            <field name="mobile" widget="mobile"/>
                            <field name="contact"/>
                            <field name="zip"/>
                            <field name="state"/>
                            <field name="country"/>

                        </group><group>
                        <div class="o_employee_avatar m-0 p-0">
                                <field name="p_image" widget="image" class="oe_avatar m-0" options="{&quot;zoom&quot;: true, &quot;p_image&quot;:&quot;p_image&quot;}"/>
                        </div></group>
                        <group>
                            <field name="gender"/>
                            <field name="age"/>
                            <field name="height"/>
                            <field name="weight"/>
                        </group>
                    </group>
                    <notebook string="Result">
                    <page string="subjects" name="subject_name">
                        <field name="subject"/>
                    </page>
                    <page string="remarks" name="remarks of subject">
                        <field name="remarks"/>
                    </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

<record id="school_management_list_view" model="ir.ui.view">
        <field name="name">school.management.list</field>
        <field name="model">school.management</field>
        <field name="arch" type="xml">
            <list string="school Management">
                <field name="mobile"/>
                <field name="age"/>
                <field name="date"/>
                <field name="state"/>
                <field name="country"/>
            </list>
        </field>
    </record>

<record id="view_kanban_school_management" model="ir.ui.view">
        <field name="name">school.management.Kanban</field>
        <field name="model">school.management</field>
        <field name="arch" type="xml">
            <kanban string="details">
                <field name="mobile"/>
                <field name="gender"/>
                <field name="zip"/>
                <field name="date"/>
                <field name="l_date"/>
                <field name="state"/>
                <field name="country"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside>
                               <t t-if="record.p_image.raw_value">
                                <field name="p_image" widget="background_image" options="{'zoom': true, 'zoom_delay': 1000, 'preview_image':'p_image'}" class="d-block position-relative"/>
                            </t>
                        </aside>

                        <main class="ms-2">
                            <div><field name="mobile"/></div>
                             <div><field name="gender"/></div>
                            <div><field name="date"/></div>
                             <field name="l_date"/>
                             <field name="zip"/>
                             <field name="state"/>
                        <footer>
                                <center>
                                <div class="d-flex ms-auto">
                                    <field name="country"/>
                                </div></center>
                        </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

<record id="school_management_search_view" model="ir.ui.view">
        <field name="name">school.management search view</field>
        <field name="model">school.management</field>
        <field name="arch" type="xml">
            <search string="User-defined Defaults">
                <field name="l_date"/>
                <field name="state"/>
                <field name="date"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="User" name="groupby_user" domain="[]" context="{'group_by':'user_id'}"/>-->
<!--                    <filter string="Company" name="groupby_company" domain="[]" context="{'group_by':'company_id'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="sale_management_form_view" model="ir.ui.view">
