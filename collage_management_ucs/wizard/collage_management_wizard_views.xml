    <record id="view_my_wizard_form" model="ir.ui.view">
        <field name="name">my.wizard.form</field>
        <field name="model">my.wizard</field>
        <field name="arch" type="xml">
            <form string="My Wizard">
                <group>
                    <field name="student_id"/>
                    <field name="description"/>
                </group>
                <footer>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                    <button string="Save" type="object" name="default_get" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>




    <record id="action_open_my_wizard" model="ir.actions.act_window">
    <field name="name">Open My Wizard</field>
    <field name="res_model">my.wizard</field>
    <field name="view_mode">list</field>
    <field name="target">new</field>
</record>




