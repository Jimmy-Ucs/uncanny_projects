<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_management_form_view" model="ir.ui.view">
        <field name="name">product.management.form</field>
        <field name="model">product.management</field>
        <field name="arch" type="xml">
            <form string="product management">
                <sheet>
                        <group>
                            <field name="my_date"/>
                            <field name="years_to_add"/>
                            <field name="exp_date"/>
                        </group>
                </sheet>
            </form>
        </field>
    </record>

<record id="product_management_list_view" model="ir.ui.view">
        <field name="name">product.management.list</field>
        <field name="model">product.management</field>
        <field name="arch" type="xml">
            <list string="product management">
                <field name="my_date"/>
                <field name="years_to_add"/>
                <field name="exp_date"/>
            </list>
        </field>
    </record>

<record id="product_management_action" model="ir.actions.act_window">
        <field name="name">product management</field>
        <field name="res_model">product.management</field>
        <field name="view_mode">form,list</field>
    </record>

    <menuitem id="product_management_menu"
              name="product_management"
              sequence="100"
              action="product_management_action"/>
</odoo>